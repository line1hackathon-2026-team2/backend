spring:
  datasource:
    url: jdbc:mysql://localhost:3306/decision_lab?serverTimezone=Asia/Seoul
    username: dl_user
    password: ${DB_PASSWORD}
  jpa:
    hibernate:
      ddl-auto: validate
  ai:
    anthropic:
      api-key: ${ANTHROPIC_API_KEY}
      chat:
        options:
          model: claude-sonnet-5-5
